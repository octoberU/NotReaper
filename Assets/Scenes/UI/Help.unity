  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "open the repeater menu with {0}\nselect targets and enter a name to create
    a repeater.\nwhile the repeater menu is open, drag the end handle on the timeline
    to adjust the repeater's length (doesn't affect other instances of that same
    repeater).\nwhile the repeater menu is open, click on an existing repeater to
    select it. \nparent repeaters are indicated by dark blue lines at the top and
    bottom. child repeaters do not have those.\nif a child repeater is selected (selection
    will be highlighted in <color=green>green</color>), you can mirror colors and
    direction.\n\n{1} - flips target colors of selected child repeater\n{2} - mirrors
    selected child repeater horizontally\n{3} - mirrors selected child repeater vertically\n{4}
    - makes selected repeater unique\n{5} - deletes the selected repeater\n{6} -
    bakes the selected repeater "
  m_isRightToLeft: 0
