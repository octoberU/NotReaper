      m_Calls: []
  m_text: "the hitsound timeline can be opened by pressing {0}\nit displays all hitsounds
    currently present in your map. \n\nyou can't add or remove any hitsound in the
    timeline: you're limited to moving them around.\n\ncopy and paste is possible,
    but it will only override existing hitsound at the time you paste.\n\ndoubled
    up hitsounds are indicated by split colors on the icon. if you left click a doubled
    up icon and drag it around, you move only one of the two and can split them up
    that way. if you want to move both together, you need to also hold <color=#FDA50F>ctrl</color>.\n\ninstead
    of dragging, you can also move hitsounds around by selecting them and then pressing
    {1} and {2}.\na third option is to hover over a hitsound marker and press a hitsound
    keybind."
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 8d6ffc87ae696bb49b961911c4703d7d, type: 2}
