  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: f4688fdb7df04437aeb418b961361dc5, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  m_Material: {fileID: 0}
  m_Color: {r: 1, g: 1, b: 1, a: 1}
  m_RaycastTarget: 1
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: 'every song has a certain <color=#FDA50F>bpm</color>, which stands for
    <color=#FDA50F>beats per minute</color>. this number indicates a song''s <color=#FDA50F>tempo</color>
    (= speed). it is crucial that you get this number right when you start your map,
    else the timing of your entire map will be off, making the process of mapping
    unnecessarily hard.


    then, there''s the <color=#FDA50F>time signature</color>.
    this tells us how to count rhythm. 99% of the time, you will encounter a time
    signature of <color=#FDA50F>4 / 4</color>. the top number tells us how many beats
    there are in one bar - in this case 4 - and the bottom number tells us how long
    each beat is - in this case a quarter note. so, a time signature of 4 / 4 means
    that each bar has 4 beats with a quarter note duration.


    to write music,
    you write notes that indicate both the pitch as well as the duration. for mapping,
    we only need to know about duration. to keep it simple, we''ll only discuss the
    most commonly used durations here.

    those would be <color=#FDA50F>quarters
    (1/4), eights (1/8) and sixteenths (1/16)</color>.

    with simple math, you
    can easily figure out that 2 1/8 and 4 1/16 notes are the same duration as a
    single 1/4 note. or, in other words, eights are twice as fast as quarters, and
    sixteenths are twice as fast as eights.'
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 8d6ffc87ae696bb49b961911c4703d7d, type: 2}
  m_sharedMaterial: {fileID: 2143181537736950723, guid: 8d6ffc87ae696bb49b961911c4703d7d,
    type: 2}
