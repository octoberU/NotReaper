      m_Calls: []
  m_text: "open the bookmarks menu by pressing {0} <size=80%>(if you're using default
    keybinds, that's a dot, just in case your eyes are shit)</size>\n\nenter a name
    and select the color you'd like. \nit will place the bookmark at the time you're
    currently at on the timeline.\n\nto edit or delete a bookmark, click the line
    icon on the timeline or press {0} when the timeline is over a bookmark.\n\nyou
    can navigate through the song with the following keybinds easily:\n{1} - jump
    to start of song\n{2} - jump to end of song\n{3} - jump to next bookmark\n{4}
    - jump to previous bookmark\n{5} - select from current to next bookmark\n{6}
    - jump to the previous bottom timeline position\n{7} - jump to the next bottom
    timeline position"
  m_isRightToLeft: 0
