  m_RaycastTarget: 1
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: 'changes the zoffset of targets.


    targets will remain at the set zoffset
    until you set a new one.

    use another zoffset modifier if you want to return
    to default zoffset (0).


    <color=#FDA50F>set transition length</color> will
    count all targets that appear from current tick to the tick you are currently
    at in the song.


    <color=#FDA50F>transition target amount</color> determines
    over how many targets the zoffset in amount should be reached.


    if transition
    target amount is 0 or empty, the zoffset will change immediately.


    <b>example</b>


    amount:
    <color=#FDA50F>100</color>

    transition target amount: <color=#FDA50F>10</color>'
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 8d6ffc87ae696bb49b961911c4703d7d, type: 2}
  m_sharedMaterial: {fileID: 2143181537736950723, guid: 8d6ffc87ae696bb49b961911c4703d7d,
