      m_Calls: []
  m_text: "open the modifiers menu by pressing {0}\n\npreview modifiers by pressing
    {1}\n\nto create a new modifier, <color=#FDA50F>left click</color> into the desired
    track at the desired time. \nto delette a modifier, press <color=#FDA50F>right
    click</color>.\nwhile holding <color=#FDA50F>control</color>, you can stretch
    or shorten a modifier.\n\nthe <color=#FDA50F>arrows</color> present in the left
    panel change the other of the tracks. this state is saved, so you can organize
    your modifiers to your liking.\n\nyou can bake zoffset by pressing {2} while
    modifiers are opened. this allows zoffset to be used on quest without the mod.
    you can bake & unbake zoffset at any time. note that once you baked zoffset,
    you don't need to do it again for this map.\n\n{3} and {4} scroll the tracks
    up and down. alternatively, you can mouse over the left panel and <color=#FDA50F>scroll</color>\n\n"
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 8d6ffc87ae696bb49b961911c4703d7d, type: 2}
