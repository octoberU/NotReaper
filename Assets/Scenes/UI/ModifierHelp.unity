  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: 'changes the color of the skybox.

    selecting the reset option will
    make the color go back to default.


    if no end tick is set, the color will
    change immediately.

    if an end tick is set, the color will fade over time.


    the
    color will stay on the color you selected until the end of the map or a new skybox
    color modifier is placed.


    the only way to reset the color back to default
    is to create a new skybox color modifier with the <color=#FDA50F>reset</color>
    option selected.


    <color=#FDA50F>requires arena loader mod!</color>'
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 8d6ffc87ae696bb49b961911c4703d7d, type: 2}
